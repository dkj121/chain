{
  "name": "chain",
  "displayName": "Chain",
  "description": "AI-driven visual design tool for ASP.NET Core Razor applications",
  "version": "0.1.0",
  "publisher": "chain",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "razor",
    "asp.net",
    "asp.net core",
    "design",
    "visual design",
    "ui builder",
    "component",
    "preview",
    "live reload",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/chain.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/chain/issues"
  },
  "activationEvents": [
    "onCommand:chain.startPreview",
    "onCommand:chain.initProject",
    "onCommand:chain.analyzeCodebase",
    "onCommand:chain.generateMockData",
    "onCommand:chain.dataSwitch",
    "onCommand:chain.consolidateStyles"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chain.startPreview",
        "title": "Chain: Start Preview"
      },
      {
        "command": "chain.stopPreview",
        "title": "Chain: Stop Preview"
      },
      {
        "command": "chain.refreshPreview",
        "title": "Chain: Refresh Preview"
      },
      {
        "command": "chain.showProperties",
        "title": "Chain: Show Properties"
      },
      {
        "command": "chain.initProject",
        "title": "Chain: Init Project"
      },
      {
        "command": "chain.analyzeCodebase",
        "title": "Chain: Analyze Codebase"
      },
      {
        "command": "chain.generateMockData",
        "title": "Chain: Generate Mock Data"
      },
      {
        "command": "chain.dataSwitch",
        "title": "Chain: Data Switch"
      },
      {
        "command": "chain.consolidateStyles",
        "title": "Chain: Consolidate Styles"
      }
    ],
    "views": {
      "chain": [
        {
          "type": "webview",
          "id": "chain.propertiesPanel",
          "name": "Properties"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chain",
          "title": "Chain",
          "icon": "$(preview)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "pnpm run test:unit",
    "test:unit": "mocha",
    "test:integration": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.x",
    "@types/sinon": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "sinon": "^22.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
